# ==============================================================================
# ComplianceOps Configuration (.env)
# ==============================================================================

# 1. AI Reasoning Engine (Google AI Studio)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. GitHub Integration (For auditing real GitHub repositories)
# Create a Personal Access Token at: https://github.com/settings/tokens
# Scopes needed: 'repo' (read-only code & contents)
GITHUB_TOKEN=

# 3. Slack HITL Policy Gates (Optional - for sending human approval alerts)
# Incoming Webhook or Bot Token
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#ai-compliance-approvals

# 4. Linear Remediation Sync (Optional - for auto-creating issue tickets)
# Create an API Key at: https://linear.app/settings/api
LINEAR_API_KEY=

# 5. Database (Defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./complianceops.db
