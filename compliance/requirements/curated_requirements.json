    "framework": "EU AI Act",
    "article": "Article 13",
    "provision": "Transparency & Provision of Information",
    "requirement": "User Transparency & Output Disclosure",
    "description": "High-risk AI systems shall be designed and developed in such a way to ensure that their operation is sufficiently transparent to enable deployers to interpret the system’s output and use it appropriately.",
    "jurisdiction": "European Union",
    "effective_date": "2026-08-02",
    "source_url": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj",
    "domain": "transparency",
    "mandatory_controls": ["ai_disclosure", "confidence_scores", "limitation_warnings"]
  },
