  },
  {
    "id": "REQ-EU-AI-004",
    "framework": "EU AI Act",
    "article": "Article 12",
    "provision": "Record-keeping",
    "requirement": "Automatic Event Logging & Auditability",
    "description": "High-risk AI systems must technically allow for the automatic recording of events (logging) over their lifetime to ensure a level of traceability of the system's functioning.",
    "jurisdiction": "European Union",
    "effective_date": "2026-08-02",
    "source_url": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj",
    "domain": "record_keeping",
    "mandatory_controls": ["audit_trail_persistence", "request_response_telemetry", "error_logging"]
  },
  {
