    "article": "Article 10",
    "provision": "Data and Data Governance",
    "requirement": "Training and Testing Data Governance",
    "description": "Training, validation, and testing data sets shall be subject to appropriate data governance practices, including design choices, data collection processes, data preparation, examination of biases, and privacy controls.",
    "jurisdiction": "European Union",
    "effective_date": "2026-08-02",
