    "article": "Article 14",
    "provision": "Human Oversight",
    "requirement": "Human-in-the-Loop & Override Controls",
    "description": "High-risk AI systems shall be designed and developed in such a way that they can be effectively overseen by natural persons during the period in which they are in use, with explicit override and stop mechanisms.",
    "jurisdiction": "European Union",
    "effective_date": "2026-08-02",
