    "article": "Article 11",
    "provision": "Technical Documentation",
    "requirement": "Comprehensive Technical Documentation & Model Card",
    "description": "The technical documentation of a high-risk AI system shall be drawn up before that system is placed on the market or put into service and kept up-to-date. Must include model card, intended use, architecture, and validation metrics.",
    "jurisdiction": "European Union",
    "effective_date": "2026-08-02",
